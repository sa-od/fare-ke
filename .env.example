# Shopify app credentials — copy these from your Partner Dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# OAuth scopes (comma-separated, must match shopify.app.toml)
SCOPES=write_products

# Public URL of this app (set automatically during `shopify app dev`)
SHOPIFY_APP_URL=https://your-tunnel.trycloudflare.com

# Postgres — sessions are persisted here, so on Vercel this MUST be a networked
# database (Neon / Vercel Postgres), not SQLite. Both names are provided by the
# Neon/Vercel integration.
# DATABASE_URL          = pooled connection (used by the app at runtime).
# DATABASE_URL_UNPOOLED = direct/unpooled connection (used by `prisma migrate`).
DATABASE_URL=postgres://user:password@host-pooler/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Optional: allow a custom myshopify.com subdomain during auth
# SHOP_CUSTOM_DOMAIN=mystore.myshopify.com
