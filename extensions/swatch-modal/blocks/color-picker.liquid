{% comment %}
  Renders only on products the merchant enabled in the app, and feeds that
  product's own colours (from its $app.palette metafield) to the picker.
{% endcomment %}
{% if product.metafields["$app"].enabled.value %}
{{ 'color-picker.css' | asset_url | stylesheet_tag }}

<style>
  /* Every colour the picker uses is driven from these block settings. They are
     set on :root because the shade modal is rendered at <body> level, so it
     can't inherit variables scoped to the picker element. */
  :root {
    --pk-accent:        {{ block.settings.accent_color }};
    --pk-text:          {{ block.settings.text_color }};
    --pk-btn-white-bg:  {{ block.settings.white_btn_color }};
    --pk-btn-custom-bg: {{ block.settings.custom_btn_color }};
  }
</style>

{%- comment -%}
  Hide the theme's tier option from customers — it's driven silently by the
  colour picker. We read the product's ACTUAL tier option (from the saved
  variant_config mapping, or the legacy "2nd option is the tier" assumption),
  take that option's real values, and hide whichever option group contains
  them. Matching value / data-value / data-option-value covers selects,
  radios and custom button pills, and using the real values (not a hardcoded
  Base/Light/Medium/Dark) means it works however the merchant named the tiers.
{%- endcomment -%}
{%- liquid
  assign tier_cfg = product.metafields["$app"].variant_config.value
  assign tier_name = tier_cfg.tierOption
  if tier_name == blank and product.options.size > 1
    assign tier_name = product.options[1]
  endif
  assign tier_opt = null
  for opt in product.options_with_values
    if opt.name == tier_name
      assign tier_opt = opt
      break
    endif
  endfor
-%}
{%- if tier_opt and tier_opt.values.size > 0 -%}
<style>
  {%- for v in tier_opt.values -%}
  {%- assign ev = v | strip | replace: '"', '\"' -%}
  :is(fieldset,.variant-option,.product-form__input,.product-form__input--pill,.product-form__option,.variant-input-wrap,.selector-wrapper,[data-option-index],[data-option-name],[data-fieldset-index]):has(:is([value="{{ ev }}"],[data-value="{{ ev }}"],[data-option-value="{{ ev }}"])){display:none!important;}
  {%- endfor -%}
</style>
{%- endif -%}

<script>
  window.__paintData = {
    variants:    {{ product.variants | json }},
    optionNames: {{ product.options | json }},
    shades:      {{ product.metafields["$app"].palette.value | json }},
    tierConfig:  {{ product.metafields["$app"].variant_config.value | json }}
  };
</script>

<div class="cp-picker">
  {% if block.settings.control_label != blank %}
    <span class="cp-picker__label">{{ block.settings.control_label }}</span>
  {% endif %}

  <div class="cp-btn-row">
    <button type="button" id="select-base-color" class="cp-btn cp-btn--white">
      {{ block.settings.white_label }}
    </button>
    <button
      type="button"
      id="open-shade-modal"
      class="cp-btn cp-btn--custom"
      data-default-label="{{ block.settings.button_label }}"
    >
      {{ block.settings.button_label }}
    </button>
  </div>

  <p class="cp-error" id="pk-error" role="alert" hidden></p>
</div>

<script type="module" src="{{ 'color-picker.js' | asset_url }}"></script>
{% endif %}

{% schema %}
{
  "name": "Paint Colour Picker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "control_label",
      "label": "Control heading",
      "default": "Color Code"
    },
    {
      "type": "text",
      "id": "white_label",
      "label": "Base (white) button label",
      "default": "White"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Colour picker button label",
      "default": "Colored"
    },
    {
      "type": "color",
      "id": "white_btn_color",
      "label": "Base button colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "custom_btn_color",
      "label": "Colour picker button colour",
      "default": "#1a6faf"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "info": "Focus rings, selected swatch, checkmark, title highlight.",
      "default": "#1a6faf"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "info": "Labels, modal title and the selected colour code.",
      "default": "#333333"
    }
  ]
}
{% endschema %}
