{{ 'color-picker.css' | asset_url | stylesheet_tag }}

<script>
  window.__paintData = {
    variants: {{ product.variants | json }}
  };
</script>

<button
  type="button"
  id="open-shade-modal"
  style="width:100%;padding:12px 16px;background:#1a1a1a;color:#fff;border:none;cursor:pointer;font-size:15px;letter-spacing:.04em;"
>
  {{ block.settings.button_label }}
</button>

<div style="display:flex;align-items:center;gap:10px;margin-top:10px;min-height:24px;">
  <span
    id="selected-shade-swatch"
    hidden
    style="display:inline-block;width:20px;height:20px;border-radius:50%;border:1px solid #e5e7eb;flex-shrink:0;"
  ></span>
  <span id="selected-shade-display" style="font-size:13px;color:#374151;font-weight:500;"></span>
</div>

<script type="module" src="{{ 'color-picker.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Paint Shade Picker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Custom Colors"
    }
  ]
}
{% endschema %}
